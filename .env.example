# Runtime values: configure as secrets on the deployed service, never in client code.
# Local development uses .dev.vars (ignored by Git).
TAVILY_API_KEY=
GEMINI_API_KEY=
# Choose an available model supporting generateContent structured JSON + image inputs.
GEMINI_MODEL=
# Comma-separated stable authenticated user IDs; see /api/bootstrap while signed in.
REVIEWER_IDS=
