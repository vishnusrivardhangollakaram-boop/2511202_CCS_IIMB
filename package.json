{
  "name": "evidence-ai-ccs",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --max-warnings 0",
    "db:generate": "drizzle-kit generate",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "evaluate": "node scripts/evaluate.mjs",
    "corpus:prepare": "python3 scripts/prepare_corpus.py",
    "format": "prettier --write app components lib db worker tests/*.ts tests/support/*.ts scripts/test.mjs scripts/evaluate.mjs *.ts",
    "format:check": "prettier --check app components lib db worker tests/*.ts tests/support/*.ts scripts/test.mjs scripts/evaluate.mjs *.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.1",
    "json-rpc-2.0": "1.7.1",
    "prettier": "3.6.2",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.1.6",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "browserslist": "4.28.7",
    "baseline-browser-mapping": "2.11.0",
    "@babel/core": "7.29.6",
    "fast-uri": "3.1.9",
    "esbuild": "0.28.1",
    "brace-expansion@^1.0.0": "1.1.21",
    "brace-expansion@>=4.0.0 <6.0.0": "5.0.12",
    "fflate@>=0.7.0 <0.8.0": "0.7.5",
    "image-size": "2.0.3",
    "js-yaml": "4.3.2",
    "minimatch@>=10.0.0 <11.0.0": "11.0.1",
    "satori": "0.33.5",
    "undici": "7.30.1",
    "ws": "8.21.0",
    "zod": "4.6.6"
  },
  "packageManager": "pnpm@11.25.0",
  "description": "Evidence sufficiency and accountable human review for the IIMB CCS project",
  "license": "AGPL-3.0-only"
}
